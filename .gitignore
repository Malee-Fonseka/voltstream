# voltstream .gitignore — decision T010.
#
# NOT ignored on purpose: config/ (alert rules, Prometheus/Grafana provisioning and
# base.yaml are reviewable, graded artefacts), docs/report/screenshots/ (evidence),
# tests/fixtures/ (hand-computed expectations), .env.example (the template).

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Test, lint and type-check caches ------------------------------------------
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Spark run artefacts (local[*] sessions, scratch jobs) ---------------------
spark-warehouse/
metastore_db/
derby.log
*.crc
_SUCCESS
checkpoint/
checkpoints/

# --- Airflow run artefacts (if ever run outside Compose, or via bind mounts) ----
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
airflow/standalone_admin_password.txt

# --- Docker bind-mount data (named volumes never appear here; this is a guard) --
docker/data/
/data/

# --- Logs and scratch ----------------------------------------------------------
logs/
*.log
tmp/
scratch/
*.tmp
*.bak
*.swp
*~

# --- Report build artefacts (LaTeX / Pandoc intermediates; the PDF itself is a
#     deliverable and is committed) ---------------------------------------------
docs/report/*.aux
docs/report/*.out
docs/report/*.toc
docs/report/*.fls
docs/report/*.fdb_latexmk
docs/report/*.synctex.gz

# --- IDEs and OS ---------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
