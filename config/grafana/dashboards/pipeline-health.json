    {
      "id": 10,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "Kafka record timestamp to committed sink, by layer, 5-minute window. The speed layer's path ends when the zone view is in Postgres. The dashed line is the 60-second requirement.",
