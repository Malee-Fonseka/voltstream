      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, layer) (rate(voltstream_e2e_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 · {{layer}}",
          "range": true,
          "instant": false,
