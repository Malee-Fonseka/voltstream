  "panels": [
    {
      "id": 14,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Simulated time on a real-time axis.** Every timestamp the pipeline writes is simulated:\none simulated day is 5 real minutes. Each 15-minute window is drawn at the real moment it\nhappened (the `sim_clock` view), so these panels line up with the Prometheus-backed\ndashboards and with the alerts. A 30-minute range shows six simulated days."
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Simulated now",
      "description": "The newest simulated instant the speed layer has written.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(max(window_end) AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') AS \"simulated now\"\nFROM zone_metrics_rt"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Load by zone",
      "description": "Consumption per 15-simulated-minute window, all meters in the zone (zone_metrics_rt, speed view).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.anchor_real + (z.window_start - c.epoch_sim) / c.time_scale AS \"time\",\n       z.grid_zone AS metric,\n       z.total_consumption_kwh AS \"value\"\nFROM zone_metrics_rt z CROSS JOIN sim_clock c\nWHERE z.window_start >= c.epoch_sim + ($__timeFrom()::timestamptz - c.anchor_real) * c.time_scale\n  AND z.window_start < c.epoch_sim + ($__timeTo()::timestamptz - c.anchor_real) * c.time_scale\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": null,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Solar generation by zone",
      "description": "Solar output per 15-simulated-minute window. Zero from 18:00 to 06:00 simulated.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.anchor_real + (z.window_start - c.epoch_sim) / c.time_scale AS \"time\",\n       z.grid_zone AS metric,\n       z.total_solar_kwh AS \"value\"\nFROM zone_metrics_rt z CROSS JOIN sim_clock c\nWHERE z.window_start >= c.epoch_sim + ($__timeFrom()::timestamptz - c.anchor_real) * c.time_scale\n  AND z.window_start < c.epoch_sim + ($__timeTo()::timestamptz - c.anchor_real) * c.time_scale\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": null,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Renewable ratio by zone",
      "description": "Solar as a share of consumption, per window. LowRenewableContribution fires when a zone stays under the dashed line (15 %) for 3 consecutive windows, so every simulated night.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.anchor_real + (z.window_start - c.epoch_sim) / c.time_scale AS \"time\",\n       z.grid_zone AS metric,\n       z.renewable_ratio AS \"value\"\nFROM zone_metrics_rt z CROSS JOIN sim_clock c\nWHERE z.window_start >= c.epoch_sim + ($__timeFrom()::timestamptz - c.anchor_real) * c.time_scale\n  AND z.window_start < c.epoch_sim + ($__timeTo()::timestamptz - c.anchor_real) * c.time_scale\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": null,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Renewable ratio now",
      "description": "Each zone's newest window. Red below the 15 % alert threshold.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (z.grid_zone)\n       c.anchor_real + (z.window_start - c.epoch_sim) / c.time_scale AS \"time\",\n       z.grid_zone AS metric,\n       z.renewable_ratio AS \"value\"\nFROM zone_metrics_rt z CROSS JOIN sim_clock c\nORDER BY z.grid_zone, z.window_start DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Daily totals by zone (batch view)",
      "description": "The batch layer's authoritative daily rollup (zone_metrics_daily), newest simulated day first. Rows appear once a day has been billed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sim_date AS \"simulated day\",\n       grid_zone AS \"zone\",\n       total_consumption_kwh AS \"consumption kWh\",\n       total_solar_kwh AS \"solar kWh\",\n       self_consumed_kwh AS \"self-consumed kWh\",\n       export_kwh AS \"exported kWh\",\n       renewable_ratio AS \"renewable\",\n       peak_consumption_kwh AS \"peak window kWh\",\n       active_meters AS \"meters\"\nFROM zone_metrics_daily\nORDER BY sim_date DESC, grid_zone\nLIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "renewable"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "meters"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
