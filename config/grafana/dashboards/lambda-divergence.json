    {
      "id": 33,
      "type": "table",
      "title": "Reconciliation, per household",
      "description": "reconciliation_daily for the selected day, largest divergence first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT household_id AS \"household\",\n       speed_estimate AS \"speed estimate\",\n       batch_final AS \"final bill\",\n       abs_divergence AS \"|difference|\",\n       pct_divergence AS \"divergence %\",\n       tariff_effect AS \"tariff effect\",\n       data_effect AS \"data effect\"\nFROM reconciliation_daily\nWHERE sim_date = '$sim_date'\nORDER BY pct_divergence DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
