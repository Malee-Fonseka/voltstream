    {
      "id": 26,
      "type": "stat",
      "title": "Speed kWh shortfall",
      "description": "Energy the speed layer did not see, as a share of what the batch layer billed. T094's band is 0.25-5 %.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100 * (sum(b.consumption_kwh) - sum(s.consumption_kwh))\n       / nullif(sum(b.consumption_kwh), 0) AS \"shortfall %\"\nFROM household_bill_daily b\nJOIN household_running_rt s USING (household_id, sim_date)\nWHERE b.sim_date = '$sim_date'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
