# voltstream — environment template (decision T018).
#
#   cp .env.example .env        # then `make up`; nothing needs editing for a local run
#
# What lives here vs config/base.yaml:
#   .env        deployment and bootstrap values read by Docker Compose, the tier-2 init
#               scripts (Kafka topics, MinIO buckets, Postgres roles) and Airflow.
#   base.yaml   application tunables read by Python through voltstream.config
#               (time scale, tariff structure, watermark, fault rates, alert thresholds).
#   Names both sides need (topic and bucket names) are defined ONCE here; base.yaml
#   carries the same defaults for no-Docker runs and scripts/smoke_test.sh (T050)
#   asserts the two agree.
#
# Every value below is a safe, non-secret LOCAL default. Real deployments replace the
# credentials; nothing in this file is reused anywhere real.
# Composite URIs (JDBC/SQLAlchemy strings, Airflow connection URIs) are assembled in
# docker-compose.yml from these parts — Compose interpolation is guaranteed, .env
# interpolation is not.

# ============================================================================
# Compose
# ============================================================================
# Project name; D7 — must be `voltstream` regardless of the repository folder name.
COMPOSE_PROJECT_NAME=voltstream
# Tag applied to the three locally built images (voltstream-app/-spark/-airflow:<tag>).
VOLTSTREAM_IMAGE_TAG=local
# All containers run in UTC; simulated time (§3.4) is UTC as well.
TZ=UTC

# ============================================================================
# Application (voltstream.config)
# ============================================================================
# Optional overlay file config/<VOLTSTREAM_ENV>.yaml merged over base.yaml; a missing
# overlay is not an error. `local` = laptop overrides, `docker` = none.
VOLTSTREAM_ENV=docker
# Directory holding base.yaml. Containers override this to /app/config in Compose.
VOLTSTREAM_CONFIG_DIR=./config
# Root log level for the structured JSON logger (DEBUG, INFO, WARNING).
VOLTSTREAM_LOG_LEVEL=INFO
# Shared simulated-clock anchor: the REAL instant that maps to simulation.epoch_sim.
# Compose passes this to every application container, so they all convert a given real
# instant to the same simulated one.
#
# Leave it empty and each process anchors on its own start time. That keeps the dates
# sane, but two processes starting seconds apart drift by skew x time_scale (5 real
# seconds = 24 simulated minutes), which is enough to put one reading in the wrong
# window. Set it for any run where the numbers matter:
#
#   VOLTSTREAM_ANCHOR_REAL=$(date -u +%Y-%m-%dT%H:%M:%SZ)   # before bringing the stack up
#
# Compose looks for `.env` beside the compose file (`docker/`), not at the repo root, so
# it must be pointed at this one explicitly -- as scripts/smoke_test.sh already does:
#
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
#
# Without --env-file the anchor silently resolves to empty and each container falls back
# to its own start time.
#
# It must be close to the run's actual start. It is an anchor for elapsed real time,
# scaled by 288 -- a value a day stale puts simulated time 288 days out, and one left at
# the start of the year puts it two centuries out.
VOLTSTREAM_ANCHOR_REAL=

# ============================================================================
# PostgreSQL — application database (serving layer, §5.5)
# ============================================================================
# Superuser created by the official image on first init; owns the app database.
POSTGRES_USER=voltstream
# Local-only password. Replace outside a laptop.
POSTGRES_PASSWORD=voltstream
# Application database: schema from docker/init/postgres/*.sql.
POSTGRES_DB=voltstream
# Hostname inside the Compose network (the service name).
POSTGRES_HOST=postgres
# Port inside the Compose network.
POSTGRES_PORT=5432
# Port published on the host for psql / Grafana-from-host; change if 5432 is taken.
POSTGRES_HOST_PORT=5432
# Read-only role `voltstream_reader`, used by Grafana and sql_exporter (T147, T151).
# Local-only password; postgres-init sets it on every `up`.
POSTGRES_READER_PASSWORD=voltstream-reader

# ============================================================================
# PostgreSQL — Airflow metadata database (D6: same instance, separate database)
# ============================================================================
# Role that owns the Airflow metadata DB; created by docker/init/postgres/00_airflow_db.sql.
AIRFLOW_DB_USER=airflow
# Local-only password.
AIRFLOW_DB_PASSWORD=airflow
# Airflow's own database. Never the application database.
AIRFLOW_DB_NAME=airflow

# ============================================================================
# Kafka — KRaft, single broker (§5.2)
# ============================================================================
# KRaft cluster id (22-char base64 UUID). MUST stay constant for the life of the data
# volume: a changed id makes the broker refuse to start against its existing log.
KAFKA_CLUSTER_ID=Tsb-BTJJRQWukaYvUsVNIA
# Bootstrap address inside the Compose network (INTERNAL listener).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Port published on the host (EXTERNAL listener) for kafka-console-consumer and tests.
KAFKA_HOST_PORT=29092
# Main topic; message key = household_id (§3.3d). Mirrored in base.yaml kafka.topic.
KAFKA_TOPIC=meter.readings
# Dead-letter topic for records that fail validation (§8.3).
KAFKA_DLQ_TOPIC=meter.readings.dlq
# Partition count = parallelism ceiling per consumer group (§5.2).
KAFKA_PARTITIONS=3
# Retention in ms: 7 days — "the mechanical reason Lambda beats Kappa here" (§5.2).
KAFKA_RETENTION_MS=604800000

# ============================================================================
# MinIO — object storage for the master dataset (§5.4)
# ============================================================================
# Root user (MinIO requires >= 3 chars).
MINIO_ROOT_USER=voltstream
# Root password (MinIO requires >= 8 chars). Local-only.
MINIO_ROOT_PASSWORD=voltstream-dev
# S3 API endpoint inside the Compose network.
MINIO_ENDPOINT=http://minio:9000
# S3 API port published on the host.
MINIO_HOST_PORT=9000
# Web console port published on the host.
MINIO_CONSOLE_HOST_PORT=9001
# Master dataset: raw meter readings, Parquet, partitioned by sim_date/hour (§6.3).
MINIO_BUCKET_RAW=voltstream-raw
# Daily tariff/weather drops, as received.
MINIO_BUCKET_LANDING=voltstream-landing
# Processed reference files, immutable.
MINIO_BUCKET_ARCHIVE=voltstream-archive
# Listed in §6.3 for Spark checkpoints; T044 puts checkpoints on named Docker volumes
# instead. Kept until T047/T182 reconcile §6.3 with §8.5.
MINIO_BUCKET_CHECKPOINTS=voltstream-checkpoints

# ============================================================================
# S3 client credentials (boto3 and Spark's s3a both read these) — same as MinIO root
# ============================================================================
# Access key = MinIO root user.
AWS_ACCESS_KEY_ID=voltstream
# Secret key = MinIO root password.
AWS_SECRET_ACCESS_KEY=voltstream-dev
# boto3 requires a region even for MinIO; the value is arbitrary.
AWS_DEFAULT_REGION=us-east-1
# boto3 >= 1.28 honours this natively, so objectstore.py needs no endpoint plumbing.
AWS_ENDPOINT_URL=http://minio:9000

# ============================================================================
# Spark (local[*] inside the voltstream-spark image)
# ============================================================================
# Driver heap for the streaming jobs; raise if the speed layer OOMs on a small laptop.
SPARK_DRIVER_MEMORY=1g

# ============================================================================
# Airflow (D6: one `airflow standalone` container, LocalExecutor)
# ============================================================================
# UID that owns mounted dags/logs (Linux hosts); harmless on Docker Desktop.
AIRFLOW_UID=50000
# Fernet key used to encrypt connection passwords in the metadata DB. DEV ONLY —
# generate a fresh one for anything real: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=2WQECGyErEDFRnrK1VJJxi_98AOICLu8uiDv7WosC6s=
# Web UI login for the demo.
AIRFLOW_ADMIN_USER=admin
# Local-only password.
AIRFLOW_ADMIN_PASSWORD=admin
# Airflow UI port published on the host.
AIRFLOW_HOST_PORT=8080

# ============================================================================
# API and dashboard (§5.8)
# ============================================================================
# FastAPI port published on the host; /docs, /metrics and the dashboard live here.
API_HOST_PORT=8000

# ============================================================================
# Observability (§5.7)
# ============================================================================
# Prometheus UI/API port on the host.
PROMETHEUS_HOST_PORT=9090
# Pushgateway port on the host (short-lived batch jobs push here — T116).
PUSHGATEWAY_HOST_PORT=9091
# Alertmanager UI/API port on the host.
ALERTMANAGER_HOST_PORT=9093
# Grafana port on the host.
GRAFANA_HOST_PORT=3000
# Grafana admin login (anonymous viewer access is enabled separately in Compose, T155).
GF_SECURITY_ADMIN_USER=admin
# Local-only password.
GF_SECURITY_ADMIN_PASSWORD=admin
